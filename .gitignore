# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local full viewport QA dumps (heroes committed separately)
docs/qa-screenshots/premium-v1/*-*.png
!docs/qa-screenshots/premium-v1/home-desktop-hero.png
!docs/qa-screenshots/premium-v1/home-mobile-hero.png
!docs/qa-screenshots/premium-v1/seattle-390.png
!docs/qa-screenshots/premium-v1/bay-area-390.png

