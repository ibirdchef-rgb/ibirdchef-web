NEXT_PUBLIC_SITE_URL=https://ibirdchef.com
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Server-only CLOW signed intake (never expose to the browser)
CLOW_IBIRDCHEF_INTAKE_URL=https://clow.prosperityaxis.com/api/inbound/ibirdchef
IBIRDCHEF_INQUIRY_WEBHOOK_SECRET=

# ANS Food Business Fit — local MCP development server
ANS_MCP_HOST=127.0.0.1
ANS_MCP_PORT=8787
ANS_MCP_URL=http://127.0.0.1:8787

# ANS Food Business Fit — production MCP (/api/mcp)
# Set a long random secret in Vercel Production only. Never commit the real value.
ANS_MCP_AUTH_TOKEN=
ANS_MCP_REQUIRE_AUTH=
ANS_MCP_RATE_LIMIT_MAX=60
ANS_MCP_PRE_AUTH_RATE_LIMIT_MAX=30
ANS_MCP_PRODUCTION_URL=https://ibirdchef.com/api/mcp
# Shared rate-limit store (Vercel KV or Upstash Redis REST).
# Required whenever MCP auth is enforced: VERCEL_ENV=production or ANS_MCP_REQUIRE_AUTH=true.
# Use one complete matching pair only. Never mix URL/token across providers. Never commit real values.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI Apps domain verification (plain-text token only; never commit the real value)
OPENAI_APPS_DOMAIN_CHALLENGE=
ANS_DOMAIN_VERIFICATION_CHALLENGE=

# ANS Corporation owner/legal configuration
# Approved Marketplace support email (general support only; not privacy/data-deletion)
ANS_SUPPORT_EMAIL=support@prosperityaxis.com
ANS_SUPPORT_URL=https://ibirdchef.com/support
ANS_SUPPORTED_COUNTRIES=United States
# Owner-approved Business Fit privacy / legal defaults are coded in owner-config.
# Override only if needed. Never commit secrets here.
ANS_PRIVACY_CONTACT_EMAIL=order@ibirdchef.com
ANS_BUSINESS_ADDRESS=3850 Klahanie Dr SE, Building 23, Apt 306, Sammamish, WA 98029, United States
ANS_GOVERNING_JURISDICTION=Washington State
ANS_DATA_RETENTION_STATEMENT=Submitted data is retained only as long as necessary for the stated purposes, with a maximum standard retention period of 90 days, unless longer retention is legally required or needed for security, fraud prevention, dispute handling, or enforcement.
